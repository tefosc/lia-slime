{
  "permissions": {
    "allow": ["Bash(ls:*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node C:/herramienta/inicio.js" }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 5,
            "command": "curl.exe -s -o NUL --connect-timeout 0.3 -m 1 -H \"@C:/Users/prueba/AppData/Roaming/io.github.tefosc.lia/cabecera-hook.txt\" -H \"Content-Type: application/json\" --data-binary \"@-\" http://127.0.0.1:47615/evento"
          }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "bash C:/herramienta/estado.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash C:/herramienta/validar.sh", "timeout": 5 }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl.exe -s -o NUL --connect-timeout 0.3 -m 1 -H \"@C:/Users/prueba/AppData/Roaming/io.github.tefosc.lia/cabecera-hook.txt\" -H \"Content-Type: application/json\" --data-binary \"@-\" http://127.0.0.1:47615/evento",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 5,
            "command": "curl.exe -s -o NUL --connect-timeout 0.3 -m 1 -H \"@C:/Users/prueba/AppData/Roaming/io.github.tefosc.lia/cabecera-hook.txt\" -H \"Content-Type: application/json\" --data-binary \"@-\" http://127.0.0.1:47615/evento"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 5,
            "command": "curl.exe -s -o NUL --connect-timeout 0.3 -m 1 -H \"@C:/Users/prueba/AppData/Roaming/io.github.tefosc.lia/cabecera-hook.txt\" -H \"Content-Type: application/json\" --data-binary \"@-\" http://127.0.0.1:47615/evento"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node C:/herramienta/fin.js" },
          {
            "type": "command",
            "async": true,
            "timeout": 5,
            "command": "curl.exe -s -o NUL --connect-timeout 0.3 -m 1 -H \"@C:/Users/prueba/AppData/Roaming/io.github.tefosc.lia/cabecera-hook.txt\" -H \"Content-Type: application/json\" --data-binary \"@-\" http://127.0.0.1:47615/evento"
          }
        ]
      }
    ]
  },
  "theme": "dark"
}
